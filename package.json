{
  "name": "open-vms",
  "version": "0.1.0",
  "description": "Open-source multi-brand CCTV Video Management System (VMS) prototype - unify ONVIF/RTSP cameras from different vendors into one dashboard, similar in spirit to Milestone XProtect.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "onvif": "^0.7.1",
    "uuid": "^9.0.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
