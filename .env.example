# Salin file ini ke .env lalu sesuaikan nilainya

PORT=4000
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini

# Kunci enkripsi AES-256 (64 karakter hex / 32 byte) untuk password kamera &
# RTSP URL yang tersimpan di database. Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JANGAN diubah setelah kamera ditambahkan — data tidak akan bisa didekripsi
# lagi kalau kunci ini hilang/berubah. Backup kunci ini secara terpisah.
CAMERA_ENCRYPTION_KEY=ganti-dengan-64-karakter-hex-acak

# Berapa lama (hari) rekaman disimpan sebelum dihapus otomatis
RETENTION_DAYS=14

# Path ffmpeg. Kosongkan jika ffmpeg sudah ada di PATH sistem.
FFMPEG_PATH=ffmpeg

# ---- Tuning live view untuk banyak kamera sekaligus ----

# Lebar maksimum hasil transcode live view (px). Kamera dengan resolusi lebih
# besar di-downscale ke ini sebelum di-encode agar CPU/GPU lebih ringan saat
# banyak channel aktif bersamaan. Turunkan (mis. 640) kalau server terbatas.
STREAM_MAX_WIDTH=960

# Frame rate hasil transcode live view. 15 sudah cukup untuk monitoring grid;
# turunkan ke 10 kalau butuh lebih hemat CPU.
STREAM_FPS=15

# auto  = coba hardware encoder (Intel Quick Sync/h264_qsv) dulu, otomatis
#         jatuh ke software (libx264) kalau GPU/driver tidak tersedia.
# software = selalu pakai libx264 (paling kompatibel, lebih berat di CPU).
HWACCEL_MODE=auto
